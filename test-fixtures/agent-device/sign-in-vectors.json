    "tag": "web-bot-auth",
    "alg": "ed25519",
    "keyid": "RFC 7638 SHA-256 thumbprint of the Ed25519 public JWK, base64url without padding",
    "signature_agent": "absent: the header is not sent and \"signature-agent\" is not covered",
    "covered": [
      "@method",
      "@authority",
      "@path",
      "@query",
      "content-digest (when the request has a body)",
      "authorization (when the request sends one)"
    ],
    "label": "sig1",
    "created": 1795651200,
    "expires": 1795651260,
    "content_digest": "sha-256 over the exact body bytes, as an RFC 9530 dictionary member: sha-256=:<base64>:",
    "empty_query": "the @query value of a URL with no query string is the single character ?"
  },
