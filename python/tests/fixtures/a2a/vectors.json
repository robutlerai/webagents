  "jcs": {
    "about": "RFC 8785 canonical JSON: keys sorted by UTF-16 code units, no whitespace, ES6 number formatting, literal UTF-8, the shortest JSON escapes.",
    "cases": [
      {
        "name": "the spec pack's non-ASCII and number vector",
        "value": { "name": "Café", "params": { "x": 1.0, "y": 1e-6 } },
        "canonical": "{\"name\":\"Café\",\"params\":{\"x\":1,\"y\":0.000001}}"
      },
      {
        "name": "ES6 number formatting",
        "value": { "a": 1e21, "b": 100000000000000000000, "c": 0.1, "d": 1e-7, "e": -0.0, "f": 123456789012345680000, "g": 5e-324, "h": 1.5e300, "i": 42, "j": -7.25 },
        "canonical": "{\"a\":1e+21,\"b\":100000000000000000000,\"c\":0.1,\"d\":1e-7,\"e\":0,\"f\":123456789012345680000,\"g\":5e-324,\"h\":1.5e+300,\"i\":42,\"j\":-7.25}"
      },
      {
        "name": "keys sort by UTF-16 code units, so a surrogate pair sorts before U+FF5E",
        "value": { "～": 1, "😀": 2, "a": 3, "B": 4 },
        "canonical": "{\"B\":4,\"a\":3,\"😀\":2,\"～\":1}"
      },
      {
        "name": "string escapes: control characters as \\u00xx lowercase, the short escapes, slash and DEL literal",
        "value": { "s": "\u0007\u001f\b\f\n\r\t\"\\/\u007f€" },
        "canonical": "{\"s\":\"\\u0007\\u001f\\b\\f\\n\\r\\t\\\"\\\\/\u007f€\"}"
      },
      {
        "name": "nested arrays keep order; null, booleans and empty containers are literal",
        "value": { "z": [null, true, false, {}, [], { "k": [1, [2, 3]] }] },
        "canonical": "{\"z\":[null,true,false,{},[],{\"k\":[1,[2,3]]}]}"
      }
    ]
  },
  "client": {
    "about": "How either SDK calls a peer over A2A v1.0 (TypeScript src/skills/transport/a2a/a2a-client.ts, Python a2a/a2a_client.py): the card at `card_paths` in order (the second on a 404), the interface `interface_cases` pin (the first JSONRPC entry at protocol version 1.0, with its tenant), one `SendMessage` carrying `version_header`, one retry as `retry_method` on `retry_on`, and the result read as `result_cases` pin, artifacts first, then the status message (what Hermes reads). Bearer tokens are configured out of band (`config_shapes.json`, `peer_token`), never discovered.",
    "card_paths": ["/.well-known/agent-card.json", "/.well-known/agent.json"],
    "version_header": { "A2A-Version": "1.0" },
    "retry_on": -32601,
    "retry_method": "message/send",
    "interface_cases": [
      {
        "name": "the first JSONRPC 1.0 interface wins, whatever is listed before it",
        "card": {
          "supportedInterfaces": [
            { "url": "https://a.example/rest", "protocolBinding": "HTTP+JSON", "protocolVersion": "1.0" },
            { "url": "https://a.example/rpc03", "protocolBinding": "JSONRPC", "protocolVersion": "0.3" },
            { "url": "https://a.example/rpc", "protocolBinding": "JSONRPC", "protocolVersion": "1.0" },
            { "url": "https://a.example/rpc2", "protocolBinding": "JSONRPC", "protocolVersion": "1.0", "tenant": "t" }
          ]
        },
        "expect": { "url": "https://a.example/rpc" }
      },
      {
        "name": "a tenant travels with the interface",
        "card": { "supportedInterfaces": [{ "url": "https://a.example/rpc", "protocolBinding": "JSONRPC", "protocolVersion": "1.0", "tenant": "acme" }] },
        "expect": { "url": "https://a.example/rpc", "tenant": "acme" }
      },
      {
        "name": "OpenClaw's card: one JSONRPC 1.0 interface, no securitySchemes",
        "card": { "name": "openclaw", "supportedInterfaces": [{ "url": "https://oc.example/a2a/v1", "protocolBinding": "JSONRPC", "protocolVersion": "1.0" }] },
        "expect": { "url": "https://oc.example/a2a/v1" }
      },
      {
        "name": "1.0.0 and 1 are 1.0",
        "card": { "supportedInterfaces": [{ "url": "https://a.example/x", "protocolBinding": "JSONRPC", "protocolVersion": "1.0.0" }] },
        "expect": { "url": "https://a.example/x" }
      },
      {
