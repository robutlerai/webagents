    "not_configured": {
      "about": "A priced @http endpoint on an agent with no paywall is refused, never served free (2026-09-27, the final e2e re-run): 503 with this code and message in both SDKs. In TypeScript, PaymentX402Skill (the transport-side token verifier) carries no paywall and never did; a priced endpoint on an agent that has only it answered the generic sentence, which named nothing. It now answers `typescript_x402_skill.message`, which names PaymentSkill, the TypeScript seller. Python has no twin of that sentence: its PaymentSkillX402 extends PaymentSkill and IS the seller, so the generic sentence is the only refusal there. Read by typescript/tests/unit/server/paywall-x402-skill-refusal-finalfix.test.ts and python/tests/server/test_paywall_not_configured_finalfix.py.",
      "status": 503,
      "code": "payment_not_configured",
      "message": "This endpoint is priced, and the agent has no payment skill to take a payment with.",
      "typescript_x402_skill": {
        "class": "PaymentX402Skill",
        "message": "This endpoint is priced, and PaymentX402Skill verifies payment tokens on chat turns but does not sell over x402; give the agent PaymentSkill (webagents/skills/payments) to take a payment for it.",
        "python": "no twin: PaymentSkillX402 extends PaymentSkill and sells over x402 itself"
      }
