    },
    "rendered": [
      "3f2a9c1e-5b7d-4e8a-9c0b-1d2e3f4a5b6c audience=any budget=1 spent=0.35 remaining=0.65 active",
      "  9a8b7c6d-5e4f-4a3b-8c2d-1e0f9a8b7c6d audience=researcher budget=0.1 spent=0.0123 remaining=0.0877 active",
      "    11111111-2222-4333-8444-555555555555 audience=scraper budget=0.02 spent=0.02 remaining=0 settled",
      "  22222222-3333-4444-8555-666666666666 audience=writer budget=0.25 spent=0.25 remaining=0 revoked"
    ],
    "totals_line": "total budget=1.37 spent=0.6323 across 4 tokens"
  }
}
