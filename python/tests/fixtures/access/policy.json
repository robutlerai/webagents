    {
      "name": "default none with only a trust group admits the trusted",
      "policy": "trusted_closed",
      "principals": [
        "agent:https://bot.acme.com/agents/scout"
      ],
      "trust": {
        "agent": "https://bot.acme.com/agents/scout",
        "scores": {
          "billing": 0.8
