      "principals": [
        "agent:https://api.partner.example/agents/x"
      ],
      "trust": {
        "agent": "https://api.partner.example/agents/x",
        "scores": {
          "": 0.41
        }
      },
      "expect": {
        "allow": true,
        "groups": [
          "partners"
        ]
      }
    },
    {
      "name": "a member without the trust does not join a mixed group",
      "policy": "trusted",
      "principals": [
        "agent:https://api.partner.example/agents/x"
      ],
      "trust": {
        "agent": "https://api.partner.example/agents/x",
        "scores": {
          "": 0.2
        }
      },
      "expect": {
        "allow": true,
        "groups": [
          "public"
        ]
      }
    },
    {
      "name": "trust without membership does not join a mixed group",
      "policy": "trusted",
      "principals": [
        "agent:https://bot.acme.com/agents/scout"
      ],
      "trust": {
        "agent": "https://bot.acme.com/agents/scout",
        "scores": {
          "": 0.95
        }
      },
      "expect": {
        "allow": true,
        "groups": [
          "friends"
        ]
      }
    },
    {
      "name": "the platform unreachable fails closed for trust-gated groups only",
      "policy": "trusted",
      "principals": [
        "agent:https://bot.acme.com/agents/scout"
      ],
      "trust": null,
      "expect": {
        "allow": true,
        "groups": [
          "friends"
        ]
      }
    },
    {
      "name": "no lookup at all fails closed the same way",
      "policy": "trusted",
      "principals": [
        "agent:https://bot.acme.com/agents/scout"
      ],
      "expect": {
        "allow": true,
        "groups": [
          "friends"
        ]
      }
    },
    {
      "name": "evidence about another agent counts for nothing",
      "policy": "trusted",
      "principals": [
        "agent:https://bot.acme.com/agents/scout"
      ],
      "trust": {
        "agent": "https://other.example/agents/x",
        "scores": {
          "billing": 0.99
        }
      },
      "expect": {
        "allow": true,
        "groups": [
          "friends"
        ]
      }
    },
    {
      "name": "a caller with no verified agent has no trust to show",
      "policy": "trusted",
      "principals": [
        "user:@carol"
      ],
      "trust": {
        "agent": "https://bot.acme.com/agents/scout",
        "scores": {
          "billing": 0.99
        }
      },
      "expect": {
        "allow": true,
        "groups": [
          "public"
        ]
      }
    },
    {
      "name": "the owner is placed in no group, trust or not",
      "policy": "trusted",
      "principals": [
        "agent:https://bot.acme.com/agents/scout"
