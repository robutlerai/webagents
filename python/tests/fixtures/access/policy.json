{
  "about": "The access block (ADR-0045): how a caller's verified principals and tier place it in groups, and how a malformed block is refused. Python tests/access/test_policy.py and TypeScript tests/unit/access/policy.test.ts run every case. `policy` names one of `policies`; `tier` is the caller's trusted tier (owner, admin), absent for everyone else. `trust_cases` (plan item 2.5, 2026-09-26) are the trust-gated groups: `trust` is the evidence the access skill got from the platform for the verified calling agent (`agent` and a score per topic key, `\"\"` for the overall score), `null` when the platform was unreachable, absent when nothing was looked up; both fail closed. Python tests/access/test_policy_trust_w2trust.py and TypeScript tests/unit/access/policy-trust-w2trust.test.ts run them.",
  "policies": {
    "open": {
      "deny": [
        "agent:https://spam.example/**",
        "key:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
      ],
      "groups": {
        "admins": [
          "user:4b0a2f3e-1111-4c1e-9a0b-000000000001",
          "user:@alice"
        ],
        "friends": [
          "agent:https://*.acme.com/**",
          "domain:partner.example",
          "key:NzbLsXh8uDCcd-6MNwXF4W_7noWXFZAfHkxZsRGC9Xs"
        ],
        "family": [
          "agent:https://kin.example/agents/aunt"
        ]
      },
      "default": "public"
    },
    "closed": {
      "deny": [
        "agent:https://spam.example/**",
        "key:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
      ],
      "groups": {
        "admins": [
          "user:4b0a2f3e-1111-4c1e-9a0b-000000000001",
          "user:@alice"
        ],
        "friends": [
          "agent:https://*.acme.com/**",
          "domain:partner.example",
          "key:NzbLsXh8uDCcd-6MNwXF4W_7noWXFZAfHkxZsRGC9Xs"
        ],
        "family": [
          "agent:https://kin.example/agents/aunt"
        ]
      },
      "default": "none"
    },
    "channels": {
      "deny": [
        "channel:sms:+15550009999"
      ],
      "groups": {
        "vip": [
          "channel:telegram:8842",
          "channel:email:alice@example.com"
        ],
        "telegram": [
          "channel:Telegram:*"
        ],
        "friends": [
          "user:@alice"
        ]
      },
      "default": "none"
    },
    "trusted": {
      "groups": {
        "friends": [
          "agent:https://*.acme.com/**"
        ],
        "billing": {
          "trust": {
            "min": 0.6,
            "topic": "billing"
          }
        },
        "partners": {
          "members": [
            "domain:partner.example"
          ],
          "trust": {
            "min": 0.4
          }
        }
      },
      "default": "public"
    },
    "trusted_closed": {
      "groups": {
        "billing": {
          "trust": {
            "min": 0.6,
            "topic": "billing"
          }
        }
      },
      "default": "none"
    }
  },
  "trust_cases": [
    {
      "name": "a verified agent above the topic threshold joins the trust group, and its identity groups",
      "policy": "trusted",
      "principals": [
        "agent:https://bot.acme.com/agents/scout",
        "key:x1"
      ],
      "trust": {
        "agent": "https://bot.acme.com/agents/scout",
        "scores": {
          "billing": 0.7,
          "": 0.5
        }
      },
      "expect": {
        "allow": true,
        "groups": [
          "friends",
          "billing"
        ]
      }
    },
    {
      "name": "the threshold is inclusive",
      "policy": "trusted",
      "principals": [
        "agent:https://bot.acme.com/agents/scout"
      ],
      "trust": {
        "agent": "https://bot.acme.com/agents/scout",
        "scores": {
          "billing": 0.6
        }
      },
      "expect": {
        "allow": true,
        "groups": [
          "friends",
          "billing"
        ]
      }
    },
    {
      "name": "below the threshold the trust group is not joined",
      "policy": "trusted",
      "principals": [
        "agent:https://bot.acme.com/agents/scout"
      ],
      "trust": {
        "agent": "https://bot.acme.com/agents/scout",
        "scores": {
          "billing": 0.59,
          "": 0.9
        }
      },
      "expect": {
        "allow": true,
        "groups": [
          "friends"
        ]
      }
    },
    {
      "name": "a topic score never stands in for the overall score: partners needs the overall, billing takes the topic",
      "policy": "trusted",
      "principals": [
        "agent:https://api.partner.example/agents/x"
      ],
      "trust": {
        "agent": "https://api.partner.example/agents/x",
        "scores": {
          "billing": 0.9
        }
      },
      "expect": {
        "allow": true,
        "groups": [
          "billing"
        ]
      }
    },
    {
      "name": "nor the reverse: an overall score does not stand in for a topic",
      "policy": "trusted",
      "principals": [
        "agent:https://api.partner.example/agents/x"
      ],
      "trust": {
        "agent": "https://api.partner.example/agents/x",
        "scores": {
          "": 0.9
        }
      },
      "expect": {
        "allow": true,
        "groups": [
