      "expect": {
        "allow": true,
        "groups": [
          "billing"
        ]
      }
    }
  ],
  "trust_requirements": {
    "trusted": [
      {
        "min": 0.6,
        "topic": "billing"
      },
      {
        "min": 0.4,
        "topic": null
      }
    ],
    "trusted_closed": [
      {
        "min": 0.6,
        "topic": "billing"
      }
    ],
    "open": []
  },
  "cases": [
    {
      "name": "a channel sender named exactly joins every group naming it",
      "policy": "channels",
      "principals": [
        "channel:telegram:8842",
        "user:c1"
      ],
      "expect": {
        "allow": true,
        "groups": [
          "vip",
          "telegram"
        ]
      }
    },
    {
      "name": "every sender of a channel type, by wildcard",
      "policy": "channels",
      "principals": [
        "channel:telegram:1",
        "user:c2"
      ],
      "expect": {
        "allow": true,
        "groups": [
          "telegram"
        ]
      }
    },
    {
      "name": "a sender on another channel is not in the wildcard group",
      "policy": "channels",
      "principals": [
        "channel:slack:U9ABC",
        "user:c3"
      ],
      "expect": {
        "allow": false
      }
    },
    {
      "name": "a channel sender id is compared without case",
      "policy": "channels",
      "principals": [
        "channel:email:Alice@Example.com"
      ],
      "expect": {
        "allow": true,
        "groups": [
          "vip"
        ]
      }
    },
    {
      "name": "a denied channel sender is refused whatever else it matches",
      "policy": "channels",
      "principals": [
        "channel:sms:+15550009999",
        "channel:telegram:8842"
      ],
      "expect": {
        "allow": false
      }
    },
    {
      "name": "a channel pattern never matches a user principal with the same id",
      "policy": "channels",
      "principals": [
        "user:8842"
      ],
      "expect": {
        "allow": false
      }
    },
    {
      "name": "a channel sender the block does not name gets the default",
      "principals": [
        "channel:telegram:8842",
        "user:c1"
      ],
      "expect": {
        "allow": true,
        "groups": [
          "public"
        ]
      }
    },
    {
      "name": "a signed agent in a wildcard group",
