  "keys": {
    "valid": [
      "preferences",
      "project-status",
      "2026.plan_v2",
      "A"
    ],
    "invalid": [
      "",
      "../etc",
      "a/b",
      ".hidden",
      "with space",
      "x:y",
      "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    ],
    "refused": "memory: key must be a slug of letters, digits, dots, dashes and underscores (up to 128), not \"{key}\"."
  },
  "tokens": {
    "about": "ceil(characters / 4) over a message's text and its tool calls' names and arguments, plus 4 per message.",
    "cases": [
      {
        "messages": [],
        "tokens": 0
      },
      {
        "messages": [
          {
            "role": "user",
            "content": "abcd"
          }
        ],
        "tokens": 5
      },
      {
        "messages": [
          {
            "role": "user",
            "content": "abcde"
          },
          {
            "role": "assistant",
            "content": ""
          }
        ],
        "tokens": 10
      },
      {
        "messages": [
          {
            "role": "assistant",
            "content": null,
            "tool_calls": [
              {
                "id": "c1",
                "type": "function",
                "function": {
                  "name": "search",
                  "arguments": "{\"q\":\"x\"}"
                }
              }
            ]
          }
        ],
        "tokens": 8
      }
    ]
  },
