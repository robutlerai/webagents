  "namespace_grammar": {
    "_comment": "S-298 (2026-09-26): a namespace is owner, shared, or caller:<principal> with no whitespace and NO COMMA in the principal, in the SDK grammar (TS namespace.ts, PY memory_namespace.py) and on the portal (lib/storage/memory-scoped-service.ts). Lists travel as repeated `namespace` parameters, one value each; the comma-joined `namespaces=a,b` form is retired and refused. `probe` is the wave-2 review's case: a Web Bot Auth principal whose jwks path carries `x,owner`.",
    "valid": [
      "owner",
      "shared",
      "caller:user:4c3a",
      "caller:agent:https://a.example/x",
      "caller:channel:telegram:8842"
    ],
    "invalid": [
      "",
      "wa:owner",
      "caller:",
      "caller:has space",
      "caller:https://evil.example/x,owner",
      "caller:user:4c3a,shared",
      "owner,shared",
      "everyone"
    ],
    "probe": {
      "principal": "agent:https://evil.example/x,owner",
      "namespace": "caller:agent:https://evil.example/x,owner",
      "namespace_of": null
    },
    "list_wire": {
      "parameter": "namespace",
      "retired": [
        "namespaces",
        "excludeSources"
      ],
      "exclude_parameter": "excludeSource"
    }
  }
}
